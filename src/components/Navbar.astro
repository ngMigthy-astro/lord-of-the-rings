---
const path = `${Astro.url.pathname}`
const activeRoute = (url: string) =>
  path === url ? "text-amber-400" : "text-zinc-500";
---

<nav class="flex items-center gap-6 px-8 py-4 border-b border-zinc-800">
  <a
    href="/"
    class={`text-xs uppercase tracking-widest transition-colors duration-200 hover:text-zinc-300 ${activeRoute("/")}`}
  >
    Personajes
  </a>
  <a
    href="/movies"
    class={`text-xs uppercase tracking-widest transition-colors duration-200 hover:text-zinc-300 ${activeRoute("/movies")}`}
  >
    Películas
  </a>
</nav>
