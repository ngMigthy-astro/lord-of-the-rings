---
import Layout from "@/layouts/Layout.astro";
import { getBooks } from "@/services/books.service";
import BookCard from "@/components/books/BookCard.astro";

const books = await getBooks();
---

<Layout title="Libros de la Tierra Media">
  <main class="container mx-auto px-6 py-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
      <div class="space-y-2">
        <h2 class="text-4xl font-bold font-serif italic text-white tracking-tight">Cuentos y Crónicas</h2>
        <div class="h-1 w-24 bg-linear-to-r from-amber-600 to-transparent"></div>
        <p class="text-zinc-500 text-sm italic font-serif">"Las historias que nunca terminan..."</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {books.map((book) => (
        <BookCard book={book} />
      ))}
    </div>
  </main>
</Layout>
