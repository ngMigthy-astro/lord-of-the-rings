---
export const prerender = false;

import { getQuotes } from "@/services/quotes.service";
import Layout from "../../layouts/Layout.astro";
import { getCharacterById } from "../../services/characters.service";
import QuotesList from "@/components/common/QuotesList";
import {
  ChevronLeft,
  MapPin,
  Calendar,
  Heart,
  Shield,
  Sparkles,
} from "lucide-react";

const { id } = Astro.params;
const character = await getCharacterById(id!);
const quotes = await getQuotes(id, "character");

const details = [
  { label: "Raza", value: character.race, icon: Shield },
  {
    label: "Reino",
    value: character.realm?.split(",").join(", "),
    icon: MapPin,
  },
  { label: "Nacimiento", value: character.birth, icon: Sparkles },
  { label: "Muerte", value: character.death, icon: Calendar },
  { label: "Cónyuge", value: character.spouse, icon: Heart },
];

const descriptionParts = [
  character.race ? `${character.race} de la Tierra Media` : null,
  character.realm ? `del reino de ${character.realm.split(",")[0]}` : null,
  character.birth ? `nacido en ${character.birth}` : null,
].filter(Boolean);

const seoDescription = descriptionParts.length
  ? `${character.name}: ${descriptionParts.join(", ")}. Descubre todos los detalles de este personaje.`
  : `Descubre a ${character.name}, personaje de El Señor de los Anillos.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: character.name,
  ...(character.race && {
    description: `${character.race} de la Tierra Media`,
  }),
  ...(character.wikiUrl && { sameAs: character.wikiUrl }),
  ...(character.birth && { birthDate: character.birth }),
  ...(character.death && { deathDate: character.death }),
  ...(character.spouse && {
    spouse: { "@type": "Person", name: character.spouse },
  }),
};
---

<Layout title={character.name} description={seoDescription}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />

  <main class="container mx-auto px-6 py-20">
    <!-- Back Navigation -->
    <a
      href="/characters"
      class="group inline-flex items-center gap-3 text-zinc-500 hover:text-amber-500 transition-all mb-16"
    >
      <div
        class="p-2 rounded-full border border-white/5 group-hover:border-amber-500/20 group-hover:bg-amber-500/5 transition-all"
      >
        <ChevronLeft
          size={18}
          className="group-hover:-translate-x-1 transition-transform"
        />
      </div>
      <span class="text-[10px] uppercase tracking-[0.4em] font-black"
        >Regresar al Registro</span
      >
    </a>

    <!-- Character Profile -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-24">
      <!-- Left: Header info -->
      <div class="lg:col-span-1">
        <div class="relative inline-block mb-8">
          <div
            class="absolute -inset-4 bg-amber-500/20 blur-2xl rounded-full opacity-20"
          >
          </div>
          <p
            class="relative text-amber-600 text-xs tracking-[0.5em] font-black uppercase mb-4"
          >
            Registro Vital
          </p>
          <h1
            class="relative text-6xl font-black text-white font-serif italic tracking-tighter"
          >
            {character.name}
          </h1>
        </div>

        {
          character.wikiUrl && (
            <a
              href={character.wikiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-6 bg-amber-500/5 border border-amber-500/20 rounded-3xl hover:bg-amber-500/10 transition-all"
            >
              <span class="text-[10px] uppercase tracking-widest font-black text-amber-500">
                Explorar Wiki
              </span>
              <span class="text-amber-500 group-hover:translate-x-2 transition-transform">
                →
              </span>
            </a>
          )
        }
      </div>

      <!-- Right: Detailed stats -->
      <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          details.map(
            (detail) =>
              detail.value &&
              detail.value !== "NaN" && (
                <div class="p-8 bg-white/2 border border-white/5 backdrop-blur-md rounded-[2.5rem] flex flex-col gap-4 group hover:bg-white/4 transition-all">
                  <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-500/10 rounded-xl border border-amber-500/20">
                      <detail.icon className="text-amber-600 w-4 h-4" />
                    </div>
                    <span class="text-zinc-500 text-[10px] uppercase tracking-[0.2em] font-bold">
                      {detail.label}
                    </span>
                  </div>
                  <p class="text-white font-serif italic text-2xl tracking-tight leading-snug">
                    {detail.value}
                  </p>
                </div>
              ),
          )
        }
      </div>
    </div>

    <!-- Quotes Section -->
    <QuotesList client:load quotes={quotes} />
  </main>
</Layout>
